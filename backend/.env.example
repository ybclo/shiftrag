# ShiftRAG Backend — Environment Template
# Copy to .env and adjust

ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Qdrant modes: memory | local | remote
QDRANT_MODE=memory
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=shiftrag_docs
QDRANT_VECTOR_SIZE=384

# Embeddings
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=32

# Chunking
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Uploads
UPLOAD_DIR=/tmp/shiftrag_uploads
MAX_FILE_SIZE_MB=25
